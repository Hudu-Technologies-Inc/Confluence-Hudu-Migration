$ConfluenceToken = "longsecretstring"
$ConfluenceDomain = "yoururl.atlassian.net" #'hudu-integrations' would be valid for 'https://www.hudu-integrations.atlassian.net'
$Confluence_Username = "confluence-email@tld.net"
$HuduBaseURL = "https://yoururlhere"
$HuduAPIKey = ""
$SkipArchivedConfluenceContent = $true # skips Confluence pages whose API status is not current
$ExportConfluenceTables = $false # or set $env:CONFLUENCE_EXPORT_TABLES = "true"
$ConfluenceTableSchemaMatchThreshold = 0.86
$userDataDir = "x:\tegrity" # fully qualified path to store data and logs
. .\Confluence-Migration.ps1
